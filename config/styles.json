{
  "note": "The 10 editing styles. The remotion agent renders every one of these from the same composition by reading these fields, so a new style is a new entry here, not new code. Times are seconds, sizes are fractions of frame height.",
  "styles": [
    {
      "id": "clean-talking-head",
      "name": "Clean Talking Head",
      "for": ["recorded"],
      "use_when": "Regular face-to-camera videos where the person is the content.",
      "captions": {"mode": "line", "position": "bottom", "size": 0.045, "max_words": 7, "highlight": false},
      "zoom": {"punch_in_every": 12, "scale": 1.08, "on_emphasis": true},
      "cuts": {"jump_cuts": true, "transition": "none"},
      "broll": {"density": "low", "layout": "fullscreen"},
      "overlays": ["lower-third-intro"],
      "music": {"enabled": true, "volume": 0.08},
      "sfx": "none",
      "grade": "neutral"
    },
    {
      "id": "hormozi",
      "name": "Hormozi Captions",
      "for": ["recorded", "faceless"],
      "use_when": "Business, motivation, advice. Every word lands on screen.",
      "captions": {"mode": "word-pop", "position": "center", "size": 0.075, "max_words": 3, "highlight": true, "uppercase": true},
      "zoom": {"punch_in_every": 5, "scale": 1.15, "on_emphasis": true},
      "cuts": {"jump_cuts": true, "transition": "none"},
      "broll": {"density": "medium", "layout": "fullscreen"},
      "overlays": ["emoji-pop", "keyword-highlight"],
      "music": {"enabled": true, "volume": 0.1},
      "sfx": "subtle",
      "grade": "contrast"
    },
    {
      "id": "fast-hype",
      "name": "Fast Hype",
      "for": ["recorded", "faceless"],
      "use_when": "Entertainment, challenges, reactions. Nothing on screen longer than 3 seconds.",
      "captions": {"mode": "word-pop", "position": "center", "size": 0.08, "max_words": 2, "highlight": true, "uppercase": true},
      "zoom": {"punch_in_every": 3, "scale": 1.2, "on_emphasis": true, "shake": true},
      "cuts": {"jump_cuts": true, "transition": "whip"},
      "broll": {"density": "high", "layout": "fullscreen"},
      "overlays": ["text-slam", "emoji-pop", "progress-bar"],
      "music": {"enabled": true, "volume": 0.14},
      "sfx": "heavy",
      "grade": "vivid"
    },
    {
      "id": "documentary",
      "name": "Documentary",
      "for": ["faceless", "recorded"],
      "use_when": "History, stories, investigations. Slow, credible, image-led.",
      "captions": {"mode": "line", "position": "bottom", "size": 0.04, "max_words": 9, "highlight": false},
      "zoom": {"ken_burns": true, "scale": 1.1},
      "cuts": {"jump_cuts": false, "transition": "crossfade"},
      "broll": {"density": "full", "layout": "fullscreen"},
      "overlays": ["lower-third-source", "date-stamp", "map-callout"],
      "music": {"enabled": true, "volume": 0.12},
      "sfx": "none",
      "grade": "film"
    },
    {
      "id": "tech-explainer",
      "name": "Tech Explainer",
      "for": ["recorded", "faceless"],
      "use_when": "Screen recordings, software, how-it-works. The screen is the star.",
      "captions": {"mode": "line", "position": "bottom", "size": 0.04, "max_words": 8, "highlight": true},
      "zoom": {"follow_cursor": true, "scale": 1.6},
      "cuts": {"jump_cuts": true, "transition": "slide"},
      "broll": {"density": "low", "layout": "pip-face"},
      "overlays": ["callout-box", "keyboard-shortcut", "code-highlight"],
      "music": {"enabled": true, "volume": 0.06},
      "sfx": "subtle",
      "grade": "neutral"
    },
    {
      "id": "podcast",
      "name": "Podcast",
      "for": ["recorded"],
      "use_when": "Two or more speakers, interviews, long conversations.",
      "captions": {"mode": "karaoke", "position": "bottom", "size": 0.045, "max_words": 6, "highlight": true, "speaker_label": true},
      "zoom": {"switch_on_speaker": true, "scale": 1.05},
      "cuts": {"jump_cuts": false, "transition": "none"},
      "broll": {"density": "none", "layout": "split"},
      "overlays": ["speaker-name", "waveform", "topic-card"],
      "music": {"enabled": false, "volume": 0},
      "sfx": "none",
      "grade": "warm"
    },
    {
      "id": "listicle",
      "name": "Listicle / Top 10",
      "for": ["faceless", "recorded"],
      "use_when": "Rankings, top-N, countdowns.",
      "captions": {"mode": "line", "position": "bottom", "size": 0.05, "max_words": 7, "highlight": true},
      "zoom": {"ken_burns": true, "scale": 1.08},
      "cuts": {"jump_cuts": false, "transition": "number-wipe"},
      "broll": {"density": "full", "layout": "fullscreen"},
      "overlays": ["number-card", "countdown", "rank-badge"],
      "music": {"enabled": true, "volume": 0.12},
      "sfx": "subtle",
      "grade": "vivid"
    },
    {
      "id": "storytime",
      "name": "Storytime",
      "for": ["faceless"],
      "use_when": "Narrated stories over footage. The voice carries it.",
      "captions": {"mode": "karaoke", "position": "center", "size": 0.06, "max_words": 4, "highlight": true},
      "zoom": {"ken_burns": true, "scale": 1.12},
      "cuts": {"jump_cuts": false, "transition": "crossfade"},
      "broll": {"density": "full", "layout": "fullscreen"},
      "overlays": ["chapter-card"],
      "music": {"enabled": true, "volume": 0.14},
      "sfx": "ambient",
      "grade": "moody"
    },
    {
      "id": "step-by-step",
      "name": "Step by Step",
      "for": ["recorded", "faceless"],
      "use_when": "Tutorials and how-tos with a fixed number of steps.",
      "captions": {"mode": "line", "position": "bottom", "size": 0.045, "max_words": 8, "highlight": false},
      "zoom": {"punch_in_every": 15, "scale": 1.06},
      "cuts": {"jump_cuts": true, "transition": "slide"},
      "broll": {"density": "medium", "layout": "pip-face"},
      "overlays": ["step-counter", "progress-bar", "chapter-card", "checklist"],
      "music": {"enabled": true, "volume": 0.07},
      "sfx": "subtle",
      "grade": "neutral"
    },
    {
      "id": "cinematic",
      "name": "Cinematic",
      "for": ["recorded", "faceless"],
      "use_when": "Vlogs, travel, brand films. Let the footage breathe.",
      "captions": {"mode": "none", "position": "bottom", "size": 0.035, "max_words": 10, "highlight": false},
      "zoom": {"ken_burns": false, "scale": 1.0},
      "cuts": {"jump_cuts": false, "transition": "dip-to-black"},
      "broll": {"density": "full", "layout": "fullscreen"},
      "overlays": ["letterbox", "title-card"],
      "music": {"enabled": true, "volume": 0.2},
      "sfx": "ambient",
      "grade": "teal-orange"
    }
  ]
}
