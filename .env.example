# Copy this file to .env and fill in your own keys. .env never leaves this Mac and is git-ignored.
# The agents check whether a key is set; they never print or copy its value.

# Voiceover (faceless videos) - https://elevenlabs.io -> Profile -> API keys
ELEVENLABS_API_KEY=

# Stock footage (free) - https://www.pexels.com/api/
PEXELS_API_KEY=

# AI thumbnail backgrounds and images - fill ONE of these, and set images.provider in config/channel.json
OPENAI_API_KEY=
GEMINI_API_KEY=

# Instagram (Reels + comment replies) - docs/SETUP-INSTAGRAM.md. From developers.facebook.com ->
# your app -> Instagram -> API setup with Instagram login: the INSTAGRAM app ID and secret (not the
# Meta app ID at the top of the page). The redirect address must match the one you added there.
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_REDIRECT_URI=https://localhost:8765/instagram/callback

# YouTube upload uses OAuth, not a key: put the client file from Google Cloud at
# secrets/client_secret.json. The first upload opens a browser for you to sign in.
